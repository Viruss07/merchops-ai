# ==============================================================================
# MerchOps AI — Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env.local for local development:
#    cp .env.example .env.local
# 2. Fill in the values for your local environment.
# 3. CRITICAL: Never commit .env or .env.local to version control.
# 4. CRITICAL: Do NOT expose PayPal secrets or DB credentials to AI prompts.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# RESERVED / NOT YET USED — there is no authentication or user-account system.
# Kept here for a future auth milestone; the current app is a single-tenant demo.
AUTH_SECRET=

# ------------------------------------------------------------------------------
# Demo Clock & Scenario Controls
# ------------------------------------------------------------------------------
# Deterministic demo date (YYYY-MM-DD). Runway starts from this date and invoice
# aging is derived from dueDate, so the documented Day-10 scenario is stable
# regardless of the real wall clock. Invalid values fall back to 2026-11-03.
DEMO_AS_OF=2026-11-03

# When set, /api/reset additionally requires a matching `x-demo-admin-token`
# header in production. Leave empty for local development (same-origin only).
DEMO_ADMIN_TOKEN=

# Optional sandbox account email overrides for live demo settlement.
# DEMO_CUSTOMER_EMAIL: Sandbox Personal account that pays the $1,500 Apex invoice (default: billing@apexcorp.test).
DEMO_CUSTOMER_EMAIL=
# DEMO_VENDOR_EMAIL: Sandbox Personal account that receives the $400 Nexus Cloud payout (default: billing@nexuscloud.test).
DEMO_VENDOR_EMAIL=

# Daily AI request limit across all users (default: 100). Raise to 1000 for hackathon judging.
AI_DAILY_CAP=1000

# ------------------------------------------------------------------------------
# PostgreSQL Database — RESERVED / NOT YET USED
# ------------------------------------------------------------------------------
# The prototype uses an in-memory repository; state resets on server restart.
# This variable is kept for a future persistence milestone and is not read today.
# Example local: postgresql://postgres:postgres@localhost:5432/merchops_ai
# Example hosted (Render / Neon): postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------------------
# OpenRouter API (Product AI Inference)
# ------------------------------------------------------------------------------
# Optional. Without a key (or with an invalid one) the app uses a clearly
# labelled deterministic fallback template. The draft route is rate-limited.
OPENROUTER_API_KEY=
# Free-model fallback chain (all optional; these are the defaults).
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
AI_MODEL_FALLBACK=dots-studio/dots-3-note-preview:free
AI_MODEL_FALLBACK_2=recursive/flint-v1.0:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME="MerchOps AI"

# ------------------------------------------------------------------------------
# PayPal Developer Sandbox Credentials
# ------------------------------------------------------------------------------
# Base API URL: https://api-m.sandbox.paypal.com for Sandbox
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Server-side gate for the live PayPal Sandbox payout rail.
# The browser/client CANNOT enable this. When false (default), all payouts use
# the local simulation rail. Set to true only with valid sandbox credentials.
# A real end-to-end sandbox settlement remains unverified even when enabled.
PAYPAL_PAYOUTS_ENABLED=false

# Optional: a sandbox Personal account email that receives every live sandbox payout.
# The seeded vendors use .test addresses, which PayPal leaves UNCLAIMED, so the payout
# never settles. Set this to a sandbox Personal account to see a batch reach SUCCESS.
PAYPAL_PAYOUT_RECEIVER_EMAIL=

# Required to verify PayPal webhook signatures. Without it, the webhook route
# rejects deliveries; batch polling remains available for reconciliation.
PAYPAL_WEBHOOK_ID=

# ------------------------------------------------------------------------------
# Financial Guardrails & Reserves (Values in Integer Cents)
# ------------------------------------------------------------------------------
# Minimum liquid cash reserve buffer in cents (e.g., 200000 = $2,000.00).
# CONSUMED by the server for the demo account / payout policy.
DEFAULT_MIN_RESERVE_CENTS=200000

# Default forecast window in days (1–365). CONSUMED by the runway forecast.
DEFAULT_FORECAST_DAYS=30
